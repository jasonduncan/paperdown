#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
style="report"
log_dir="${HOME}/Library/Logs/paperdown"
mkdir -p "$log_dir"
log_file="$log_dir/paperdown-$(date +%Y%m%d-%H%M%S).log"
template_file="$repo_root/templates/document.tex"

resolve_command() {
  local name="$1"
  shift

  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi

  for candidate in "$@"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

usage() {
  cat <<'EOF'
Usage: paperdown [--style STYLE] file1.md [file2.md ...]
EOF
}

next_output_path() {
  local source_path="$1"
  local base="${source_path%.md}"
  local candidate="${base}.pdf"
  local n=1

  while [[ -e "$candidate" ]]; do
    candidate="${base}-${n}.pdf"
    n=$((n + 1))
  done

  printf '%s\n' "$candidate"
}

inputs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --style)
      shift
      if [[ $# -eq 0 ]]; then
        echo "--style requires a value" >&2
        exit 2
      fi
      style="$1"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
    *)
      inputs+=("$1")
      ;;
  esac
  shift
done

if [[ "${#inputs[@]}" -eq 0 ]]; then
  usage >&2
  exit 2
fi

converted=0
failed=0
skipped=0

echo "style=${style}" >> "$log_file"
echo "repo_root=${repo_root}" >> "$log_file"

style_file="$repo_root/styles/${style}.yaml"
pandoc_bin="${PAPERDOWN_PANDOC_BIN:-}"
pdf_engine_bin="${PAPERDOWN_PDF_ENGINE_BIN:-}"

if [[ ! -f "$template_file" ]]; then
  echo "Missing template: $template_file" >&2
  echo "missing_template=$template_file" >> "$log_file"
  exit 1
fi

if [[ ! -f "$style_file" ]]; then
  echo "Unknown style: $style" >&2
  echo "missing_style=$style_file" >> "$log_file"
  exit 1
fi

if [[ -z "$pandoc_bin" ]]; then
  pandoc_bin="$(resolve_command pandoc \
    /opt/homebrew/bin/pandoc \
    /usr/local/bin/pandoc \
    "$HOME/homebrew/bin/pandoc")" || {
      echo "Missing pandoc executable" >&2
      echo "missing_command=pandoc" >> "$log_file"
      exit 1
    }
fi

if [[ -z "$pdf_engine_bin" ]]; then
  pdf_engine_bin="$(resolve_command xelatex \
    /Library/TeX/texbin/xelatex \
    /opt/homebrew/bin/xelatex \
    /usr/local/bin/xelatex)" || {
      echo "Missing xelatex executable" >&2
      echo "missing_command=xelatex" >> "$log_file"
      exit 1
    }
fi

echo "pandoc_bin=${pandoc_bin}" >> "$log_file"
echo "pdf_engine_bin=${pdf_engine_bin}" >> "$log_file"

for input_path in "${inputs[@]}"; do
  if [[ "$input_path" != *.md ]]; then
    skipped=$((skipped + 1))
    echo "skipped=$input_path" >> "$log_file"
    continue
  fi

  output_path="$(next_output_path "$input_path")"

  if "$pandoc_bin" "$input_path" \
    --from markdown \
    --pdf-engine="$pdf_engine_bin" \
    --template "$template_file" \
    --metadata-file "$style_file" \
    -o "$output_path" >>"$log_file" 2>&1; then
    converted=$((converted + 1))
    echo "converted=$input_path -> $output_path" >> "$log_file"
  else
    failed=$((failed + 1))
    echo "failed=$input_path" >> "$log_file"
  fi
done

printf 'converted %d, failed %d, skipped %d\n' "$converted" "$failed" "$skipped"

if [[ "$failed" -gt 0 ]]; then
  exit 1
fi
